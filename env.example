# Environment variable template.
#
# Copy this file to .env and fill in the real values:
#
#     cp env.example .env
#
# .env is gitignored, so your real values never get committed.
# Keep this file in sync whenever you add a new variable.

# --- Runtime ---------------------------------------------------------------

# One of: development | production
NODE_ENV=development

# Port the local server listens on.
PORT=3000

# --- Secrets ---------------------------------------------------------------
# Leave these blank here. Real values belong only in .env.

# Personal access token, API key, etc.
API_TOKEN=

# Full connection string, e.g. postgres://user:pass@localhost:5432/dbname
DATABASE_URL=
